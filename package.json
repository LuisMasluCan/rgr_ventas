{
  "name": "rgr-selva-ventas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,vite \"npm:dev:api\" \"npm:dev:vite\"",
    "dev:api": "tsx watch src/local-dev/server.ts",
    "dev:vite": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "postinstall": "prisma generate",
    "build": "npm run typecheck:api && tsc -b && vite build",
    "preview": "vite preview",
    "test:api:smoke": "node scripts/smoke-api.mjs",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck:api": "tsc -p tsconfig.serverless.json"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-to-print": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
