generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Cliente {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String
  empresa      String
  documento    String       @unique(map: "clientes_documento_unique")
  telefono     String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  cotizaciones Cotizacion[]

  @@map("clientes")
}

model Maquinaria {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  marca           String
  modelo          String
  precio          Decimal          @db.Decimal(12, 2)
  imagenUrl       String           @map("imagen_url")
  fichaTecnicaUrl String?          @map("ficha_tecnica_url")
  fotosDetalle    String[]         @default([]) @map("fotos_detalle")
  motor           String
  potencia        Decimal          @db.Decimal(8, 2)
  peso            Decimal?         @db.Decimal(10, 2)
  estado          EstadoMaquinaria @default(Disponible)
  cantidad        Int              @default(1)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  cotizaciones    Cotizacion[]

  @@map("maquinarias")
}

model Cotizacion {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clienteId       String           @map("cliente_id") @db.Uuid
  maquinariaId    String           @map("maquinaria_id") @db.Uuid
  estado          EstadoCotizacion @default(Cotizacion)
  fechaCotizacion DateTime         @default(now()) @map("fecha_cotizacion") @db.Timestamptz(6)
  notas           String?
  descripcion     String?
  cliente         Cliente          @relation(fields: [clienteId], references: [id], onUpdate: NoAction, map: "cotizaciones_cliente_id_clientes_id_fk")
  maquinaria      Maquinaria       @relation(fields: [maquinariaId], references: [id], onUpdate: NoAction, map: "cotizaciones_maquinaria_id_maquinarias_id_fk")

  @@map("cotizaciones")
}

enum EstadoMaquinaria {
  Disponible
  EnTransito @map("En Tránsito")
  Vendido

  @@map("estado_maquinaria")
}

enum EstadoCotizacion {
  Cotizacion  @map("Cotización")
  Asignados
  Contactados
  Cierre

  @@map("estado_cotizacion")
}
